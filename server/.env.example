# Copy this file to .env and fill in real values.
# .env is gitignored and must never be committed.

# Nest listens on 3000 by default, same as the Next.js client dev server —
# must differ from it. client/.env.local's NEST_API_URL should match this.
PORT=3001

# Prisma / PostgreSQL connection string.
DATABASE_URL="postgresql://user:password@localhost:5432/rabbi_websit?schema=public"

# Shared-secret header stub for admin-only routes (x-admin-secret).
# NOTE: this is a placeholder mechanism, not real cross-service auth with the
# Next.js admin session — see AdminGuard for details.
ADMIN_API_SECRET=

# --- Question notification email (MailService) ---
SMTP_HOST= 
SMTP_PORT= 587
SMTP_USER= 
SMTP_PASS=
# Where new-question notification emails are sent.
CONTACT_TO_EMAIL=
# The "from" address used when sending (often must match SMTP_USER's domain).
CONTACT_FROM_EMAIL= 
