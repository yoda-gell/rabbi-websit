# Copy this file to .env.local and fill in real values.
# .env.local is gitignored and must never be committed.

# --- Admin login (/admin) ---
# Shared password for the admin panel.
ADMIN_PASSWORD=
# Random long string used to sign admin session cookies. Generate one with:
#   node -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
ADMIN_SESSION_SECRET=

# --- NestJS backend (server/) ---
# Base URL of the NestJS API; falls back to http://localhost:3001 if unset.
NEST_API_URL=http://localhost:3001
# Shared-secret sent as the x-admin-secret header when the admin dashboard
# calls NestJS's /admin/questions routes. Must match server/.env's
# ADMIN_API_SECRET exactly — it's a stub mechanism, not real cross-service auth.
ADMIN_API_SECRET=
